# Copie para .env e preencha. Nada aqui vai para o navegador.

# Porta local do seu computador. Os scripts start escolhem uma livre sozinhos e gravam aqui.
HOST_PORT=8080

# (Opcional, recomendado em link público) Senha para abrir o site inteiro (o navegador pede usuário e senha; o usuário pode ser qualquer um)
SITE_PASSWORD=

# (Opcional) só para o perfil "named": token do túnel nomeado do Cloudflare
TUNNEL_TOKEN=

# ---- Contas e assinatura (R$ 29,99/mês, 7 dias de demonstração) ----
# Chave SECRETA do Stripe (modo teste: sk_test_...; produção: sk_live_...). Sem ela, cadastro e demonstração funcionam, mas a assinatura paga não.
STRIPE_SECRET_KEY=
# (Opcional) Segredo do webhook (whsec_...). Sem webhook, a situação da assinatura é consultada no Stripe a cada acesso.
STRIPE_WEBHOOK_SECRET=
# Segredo para assinar a sessão (se vazio, é gerado e guardado no volume de dados).
SESSION_SECRET=
# Endereço público fixo (https://seu-dominio). Se vazio, usa o endereço pelo qual o usuário acessou.
PUBLIC_URL=
